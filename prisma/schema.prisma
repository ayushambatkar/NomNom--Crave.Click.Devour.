// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  RESTAURANT_OWNER
  ADMIN
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  phoneNumber String?  @unique
  address     Address? @relation("UserAddress", fields: [addressId], references: [id])
  addressId   String?  @unique @db.Uuid
  email       String?  @unique
  name        String?
  role        UserRole @default(CUSTOMER)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  carts Cart[]
  orders Order[]
  ownedRestaurants Restaurant[]

  @@map("users")
}

model Restaurant {
  id               String  @id @default(uuid()) @db.Uuid
  name             String
  address          Address @relation("RestaurantAddress", fields: [addressId], references: [id])
  addressId        String  @unique @db.Uuid
  owner            User    @relation(fields: [ownerId], references: [id])
  ownerId          String  @db.Uuid
  openingTime      String // HH:mm
  closingTime      String // HH:mm
  handlingFee      Decimal @default(0) @db.Decimal(10, 2)
  packagingCharges Decimal @default(0) @db.Decimal(10, 2)

  menuItems MenuItem[]
  carts     Cart[]
  orders    Order[]
}

model Address {
  id         String   @id @default(uuid()) @db.Uuid
  line1      String?
  line2      String?
  landmark   String?
  city       String
  state      String?
  postalCode String?
  country    String?
  latitude   Decimal @db.Decimal(9, 6)
  longitude  Decimal @db.Decimal(9, 6)

  restaurant Restaurant? @relation("RestaurantAddress")
  user       User?       @relation("UserAddress")
}

model MenuItem {
  id           String     @id @default(uuid()) @db.Uuid
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId String     @db.Uuid
  name         String
  description  String?
  price        Decimal    @db.Decimal(10, 2)
  isAvailable  Boolean    @default(true)

  cartItems CartItem[]
  orderItems OrderItem[]
}

model Cart {
  id           String      @id @default(uuid()) @db.Uuid
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String      @unique @db.Uuid
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id])
  restaurantId String?     @db.Uuid
  items        CartItem[]

  subtotal         Decimal @default(0) @db.Decimal(10, 2)
  handlingFee      Decimal @default(0) @db.Decimal(10, 2)
  packagingCharges Decimal @default(0) @db.Decimal(10, 2)
  deliveryCharges  Decimal @default(0) @db.Decimal(10, 2)
  taxAmount        Decimal @default(0) @db.Decimal(10, 2)
  total            Decimal @default(0) @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id         String   @id @default(uuid()) @db.Uuid
  cart       Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId     String   @db.Uuid
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  menuItemId String   @db.Uuid
  quantity   Int      @default(1)
  unitPrice  Decimal  @db.Decimal(10, 2)

  @@unique([cartId, menuItemId])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  ACCEPTED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  INITIATED
  PENDING
  SUCCESS
  FAILED
}

model Order {
  id            String        @id @default(uuid()) @db.Uuid
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String        @db.Uuid
  restaurant    Restaurant?   @relation(fields: [restaurantId], references: [id])
  restaurantId  String?       @db.Uuid
  amount        Decimal       @db.Decimal(10, 2)
  paymentStatus PaymentStatus @default(INITIATED)
  orderStatus   OrderStatus   @default(PENDING)
  addressSnapshot Json
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  items         OrderItem[]
  payment       Payment?
}

model OrderItem {
  id               String    @id @default(uuid()) @db.Uuid
  order            Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId          String    @db.Uuid
  menuItem         MenuItem? @relation(fields: [menuItemId], references: [id])
  menuItemId       String?   @db.Uuid
  nameSnapshot     String
  unitPriceSnapshot Decimal   @db.Decimal(10, 2)
  quantity         Int        @default(1)
}

model Payment {
  id            String        @id @default(uuid()) @db.Uuid
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId       String        @unique @db.Uuid
  provider      String?
  status        PaymentStatus @default(INITIATED)
  transactionId String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}
