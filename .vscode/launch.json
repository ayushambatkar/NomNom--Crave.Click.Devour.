{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node-terminal",
            "name": "API: Start Dev",
            "request": "launch",
            "command": "npm run start:dev",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "npm: dev:up",
        },
        {
            "type": "node-terminal",
            "name": "API: Start Debug",
            "request": "launch",
            "command": "npm run start:debug",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "npm: dev:up",
        },
        {
            "type": "node-terminal",
            "name": "API: Start Prod",
            "request": "launch",
            "command": "npm run start:prod",
            "cwd": "${workspaceFolder}",
        },
        {
            "type": "node-terminal",
            "name": "API: Start UAT",
            "request": "launch",
            "command": "npm run start:uat",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "npm: dev:up",
        },
        {
            "type": "node-terminal",
            "name": "Payment Gateway: Start Dev",
            "request": "launch",
            "command": "npm run start:payment",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "npm: dev:up",
        },
        {
            "type": "node-terminal",
            "name": "Payment Gateway: Start Prod",
            "request": "launch",
            "command": "npm run start:payment:prod",
            "cwd": "${workspaceFolder}",
        },
        {
            "type": "node-terminal",
            "name": "Docker: Start Resources",
            "request": "launch",
            "command": "npm run dev:restart",
            "cwd": "${workspaceFolder}",
        },
        {
            "type": "node-terminal",
            "name": "Docker: Stop Resources",
            "request": "launch",
            "command": "npm run dev:down",
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "node-terminal",
            "name": "Prisma Studio: API Database",
            "request": "launch",
            "command": "npm run prisma:studio",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "npm: dev:up",
        },
        {
            "type": "node-terminal",
            "name": "Prisma Studio: Payment Database",
            "request": "launch",
            "command": "npm run prisma:studio:payment",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "npm: dev:up",
        },
        {
            "type": "node-terminal",
            "name": "Format Workspace",
            "request": "launch",
            "command": "npm run format",
            "cwd": "${workspaceFolder}"
        }
    ],
    "compounds": [
        {
            "name": "Start All Apps (API + Payment Gateway)",
            "configurations": [
                "API: Start Dev",
                "Payment Gateway: Start Dev"
            ],
            "preLaunchTask": "npm: dev:up",
            "stopAll": true
        }
    ]
}