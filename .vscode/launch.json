{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node-terminal",
            "name": "Start Dev",
            "request": "launch",
            "command": "npm run start:dev",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "npm: dev:up",
        },
        {
            "type": "node-terminal",
            "name": "Start Resources",
            "request": "launch",
            "command": "npm run dev:restart",
            "cwd": "${workspaceFolder}",
        },
        {
            "type": "node-terminal",
            "name": "Stop Resources",
            "request": "launch",
            "command": "npm run dev:down",
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "node-terminal",
            "name": "Format Workspace",
            "request": "launch",
            "command": "npm run format",
            "cwd": "${workspaceFolder}"
        }
    ]
}