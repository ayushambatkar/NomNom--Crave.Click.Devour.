    "version": "0.2.0",
    "configurations": [
        {
            "type": "node-terminal",
            "name": "Dev",
            "request": "launch",
            "command": "npm run start:dev",
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "node-terminal",
            "name": "Start DB server",
            "request": "launch",
            "command": "npm run db:dev:restart",
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "node-terminal",
            "name": "Format Workspace",
            "request": "launch",
            "command": "npm run format",
            "cwd": "${workspaceFolder}"
        }
    ]
}