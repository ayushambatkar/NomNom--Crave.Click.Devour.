# Environment variables template
# Copy this file to .env.development, .env.uat, or .env.production and fill in the values

# Application
NODE_ENV=development
PORT=3000
PAYMENT_PORT=3001

# Database - Main API
DATABASE_URL="postgresql://user:password@localhost:5432/database?schema=public"

# Database - Payment Gateway
PAYMENT_DATABASE_URL="postgresql://paymentuser:paymentpassword@localhost:5433/paymentdb?schema=public"

# Payment Gateway Integration
PAYMENT_GATEWAY_URL="http://localhost:3001"
API_WEBHOOK_URL="http://localhost:3000/webhooks/payment"

# JWT
JWT_SECRET="your-secret-key-here"
JWT_EXPIRES_IN="30d"
JWT_REFRESH_EXPIRES_IN="30d"

# Redis
REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# Business Logic
PER_KM_DELIVERY_RATE=10

# RabbitMQ
RABBITMQ_URL="amqp://admin:admin@localhost:5672"

# Seeding (for development/testing)
SEED_CENTER_LAT="28.6139"
SEED_CENTER_LNG="77.2090"
SEED_MAX_RADIUS_KM="12"
