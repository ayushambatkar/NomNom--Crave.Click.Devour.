{
  "name": "nomnom_api",
  "version": "1.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev:up": "docker compose up -d",
    "dev:down": "docker compose down",
    "dev:restart": "npm run dev:down && npm run dev:up",
    "dev:rm": "docker compose rm dev-db dev-redis -s -f",
    "db:seed": "dotenv -e .env.development -- node -r ts-node/register apps/api/prisma/seed.ts",
    "db:seed:uat": "dotenv -e .env.uat -- node -r ts-node/register apps/api/prisma/seed.ts",
    "db:seed:prod": "dotenv -e .env.production -- node -r ts-node/register apps/api/prisma/seed.ts",
    "db:clear": "dotenv -e .env.development -- node -r ts-node/register apps/api/prisma/clear_db.ts",
    "db:clear:uat": "dotenv -e .env.uat -- node -r ts-node/register apps/api/prisma/clear_db.ts",
    "db:clear:prod": "dotenv -e .env.production -- node -r ts-node/register apps/api/prisma/clear_db.ts",
    "db:deploy:dev": "dotenv -e .env.development -- prisma migrate deploy --schema=apps/api/prisma/schema.prisma",
    "db:deploy:uat": "dotenv -e .env.uat -- prisma migrate deploy --schema=apps/api/prisma/schema.prisma",
    "db:deploy:prod": "dotenv -e .env.production -- prisma migrate deploy --schema=apps/api/prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema=apps/api/prisma/schema.prisma",
    "prisma:generate:payment": "prisma generate --schema=apps/payment-gateway/prisma/schema.prisma",
    "build": "nest build",
    "build:api": "nest build api",
    "build:payment": "nest build payment-gateway",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:dev": "cross-env NODE_ENV=development nest start api --watch",
    "start:payment": "cross-env NODE_ENV=development nest start payment-gateway --watch",
    "start:uat": "cross-env NODE_ENV=uat nest start api --watch",
    "start:debug": "cross-env NODE_ENV=development nest start api --debug --watch",
    "start:prod": "cross-env NODE_ENV=production node dist/apps/api/main",
    "start:payment:prod": "cross-env NODE_ENV=production node dist/apps/payment-gateway/main",
    "lint": "eslint \"{apps,libs}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./apps/api/test/jest-e2e.json"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mapped-types": "*",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@prisma/client": "^6.16.1",
    "amqplib": "^0.10.9",
    "argon": "^2.0.21",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "ioredis": "^5.8.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/amqplib": "^0.10.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "^6.16.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@app/common(|/.*)$": "<rootDir>/libs/common/src/$1",
      "^@app/rabbitmq(|/.*)$": "<rootDir>/libs/rabbitmq/src/$1",
      "^@app/redis(|/.*)$": "<rootDir>/libs/redis/src/$1"
    }
  }
}